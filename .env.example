# ── Database ──────────────────────────────────────────────────
# Default: local SQLite.  Switch to PostgreSQL by changing the URL.
DATABASE_URL=sqlite:///./kotchy.db

# ── Codeforces API (optional for public endpoints) ───────────
CF_API_KEY=
CF_API_SECRET=

# ── CSES Authentication (optional coach/bot credentials for scraping) ──
CSES_USERNAME=
CSES_PASSWORD=

# ── Task Defaults ─────────────────────────────────────────────
# ISO datetime used when no deadline is provided for an assignment.
# Falls back to 2030-01-01T00:00:00+00:00 if omitted or invalid.
DEFAULT_TASK_DEADLINE=

# ── Authentication & Security ──────────────────────────────
# Default password used when an account is created without a password or when reset.
# Falls back to 12345678 if omitted.
DEFAULT_PASSWORD=12345678

# ── Cache & Lifetimes (seconds) ───────────────────────────
# CSES_SOLVED_CACHE_LIFETIME=60
# CSES_PROBLEM_NAMES_CACHE_LIFETIME=

# ── Debug ─────────────────────────────────────────────────────
DEBUG=false

