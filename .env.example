# ── Database ──────────────────────────────────────────────────
# Default: local SQLite.  Switch to PostgreSQL by changing the URL.
DATABASE_URL=sqlite:///./kotchy.db

# ── Codeforces API (optional for public endpoints) ───────────
CF_API_KEY=
CF_API_SECRET=

# ── Debug ─────────────────────────────────────────────────────
DEBUG=false
